# =============================================================================
# Environment Variables Example — Faeda Jobs Backend
# =============================================================================
# ⚠️  This is an example file. Copy this to `.env` and fill in the real values.
#     Do NOT put real secrets in this file, as it should be committed to git.
# =============================================================================

# Flask Configuration
SECRET_KEY=your_secret_key_here

# Database Configuration
# Local Development (SQLite default):
# DATABASE_URL=sqlite:///database.db
#
# Production Managed PostgreSQL (Neon, Supabase, AWS RDS, Render, etc.):
# DATABASE_URL=postgresql://faeda_user:password@ep-sample-pooler.region.aws.neon.tech/faeda_db?sslmode=require
# Or Supabase / RDS:
# DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///database.db

# Managed PostgreSQL Connection Pool Settings (Optional)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=300
# DB_CONNECT_TIMEOUT=15

# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Email Service Configuration (Background Queue Worker)
# Option A: SMTP (Gmail or custom mail server)
SENDER_EMAIL=coursesforyo@gmail.com
SENDER_PASSWORD=your_app_password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_DEFAULT_SENDER="Faeda Jobs <notifications@faeda.sa>"

# Option B: Transactional Email API (Optional, faster & high deliverability)
# RESEND_API_KEY=re_123456789
# SENDGRID_API_KEY=SG.123456789

# Cloudinary Cloud Storage (Optional, falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# API Rate Limiting & DoS Protection (Flask-Limiter)
RATELIMIT_ENABLED=True
# Storage URI: Default is in-memory 'memory://', or production Redis 'redis://localhost:6379/1'
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STRATEGY=moving-window
# Granular thresholds:
# RATELIMIT_AUTH="5 per minute, 30 per hour"
# RATELIMIT_REGISTER="3 per minute, 15 per hour"
# RATELIMIT_PASSWORD_RESET="3 per minute, 10 per hour"
# RATELIMIT_PUBLIC_API="60 per minute, 600 per hour"
# RATELIMIT_COMPUTE_HEAVY="10 per minute, 60 per hour"

# Moyasar Payment Gateway (Saudi Mada, Credit Cards, Apple Pay)
MOYASAR_API_URL=https://api.moyasar.com/v1
MOYASAR_PUBLISHABLE_KEY=pk_test_your_moyasar_publishable_key
MOYASAR_SECRET_KEY=sk_test_your_moyasar_secret_key
COMPANY_VAT_NUMBER=310293847500003

