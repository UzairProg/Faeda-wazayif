# =============================================================================
# Environment Variables Example — Faeda Jobs Backend
# =============================================================================
# ⚠️  This is an example file. Copy this to `.env` and fill in the real values.
#     Do NOT put real secrets in this file, as it should be committed to git.
# =============================================================================

# Flask Configuration
SECRET_KEY=your_secret_key_here

# Database Configuration (Optional, defaults to sqlite:///database.db)
DATABASE_URL=sqlite:///database.db

# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Flask-Mail Configuration (main.py)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Manual SMTP Configuration (customers.py and messages.py)
SENDER_EMAIL=your_other_email@gmail.com
SENDER_PASSWORD=your_other_app_password

# Cloudinary Cloud Storage (Optional, falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
